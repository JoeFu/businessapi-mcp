# Optional project-local configuration. The recommended way is `businessapi-mcp setup`, which stores the key in your
# user config directory; a ./.env in the directory the server starts from overrides it (handy for a checkout).
# Keys: https://businessapi.com.au/user/api-keys — sandbox keys start with bapi_sk_test_ and are free.
BAPI_API_KEY=bapi_sk_test_xxxxxxxxxxxxxxxx

# The environment is inferred from the key prefix; BAPI_ENV is only a cross-check.
# BAPI_ENV=test

# Production only: must be "true" before any live POST/PATCH/DELETE is allowed through.
# BAPI_ALLOW_LIVE=false

# Context-size controls (README: "Context size: lazy schemas and toolsets")
# BAPI_INLINE_SCHEMAS=false
# BAPI_TOOLSETS=all
