# Copy this file to bapi-mcp/.env (git-ignored). server.py and sandbox_smoke_test.py read it automatically.
# Get a key at https://businessapi.com.au/user/api-keys — sandbox keys start with bapi_sk_test_ and are free.
BAPI_API_KEY=bapi_sk_test_xxxxxxxxxxxxxxxx
BAPI_ENV=test

# Production only. BAPI_ALLOW_LIVE must be "true" before any live POST/PATCH/DELETE is allowed through.
# BAPI_ENV=live
# BAPI_ALLOW_LIVE=false

# Context-size controls (see README "Context size: lazy schemas and toolsets")
# BAPI_INLINE_SCHEMAS=false
# BAPI_TOOLSETS=all
