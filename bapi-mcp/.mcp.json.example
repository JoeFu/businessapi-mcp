{
  "mcpServers": {
    "bapi": {
      "command": "uv",
      "args": ["run", "--with", "fastmcp", "C:/ABSOLUTE/PATH/TO/bapi-mcp/server.py"],
      "env": {
        "BAPI_API_KEY": "bapi_sk_test_xxxxxxxxxxxxxxxx",
        "BAPI_ENV": "test",
        "BAPI_ALLOW_LIVE": "false",
        "BAPI_INLINE_SCHEMAS": "false",
        "BAPI_TOOLSETS": "all"
      }
    },

    "bapi-registrations": {
      "command": "uv",
      "args": ["run", "--with", "fastmcp", "C:/ABSOLUTE/PATH/TO/bapi-mcp/server.py"],
      "env": {
        "BAPI_API_KEY": "bapi_sk_test_xxxxxxxxxxxxxxxx",
        "BAPI_ENV": "test",
        "BAPI_TOOLSETS": "lookup,registrations,core"
      }
    },
    "bapi-monitoring": {
      "command": "uv",
      "args": ["run", "--with", "fastmcp", "C:/ABSOLUTE/PATH/TO/bapi-mcp/server.py"],
      "env": {
        "BAPI_API_KEY": "bapi_sk_test_xxxxxxxxxxxxxxxx",
        "BAPI_ENV": "test",
        "BAPI_TOOLSETS": "monitoring,webhooks"
      }
    }
  }
}
